--- 
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";
import CloudinaryImage from "./CloudinaryImage.astro";

const { post } = Astro.props;

// Destructure only if post and post.data exist
const {
    data: { title, description, pubDate, heroImage },
    slug,
} = post || { data: {} }; // Provide a default empty object to prevent destructuring errors if post is undefined
---

{post && post.data && (
    <article class="card">
        <a href={`/blog/${slug}/`}>
            {heroImage &&
                (typeof heroImage === "string" && heroImage.startsWith("http") ? (
                    <CloudinaryImage
                        src={heroImage}
                        alt=""
                        width={720}
                        height={360}
                        class="hero-image"
                    />
                ) : (
                    <Image
                        src={heroImage}
                        alt=""
                        width={720}
                        height={360}
                        format="webp"
                        quality={80}
                        class="hero-image"
                    />
                ))}
            <div class="content">
                <FormattedDate date={pubDate} />
                <h3 class="title">{title}</h3>
                <p class="description">{description}</p>
            </div>
        </a>
    </article>
)}

<style>
	.card {
		display: block;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		background-color: white;
		box-shadow: var(--box-shadow);
		transition: box-shadow 0.3s ease;
	}

	.card:hover {
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
	}

	.dark .card {
		background-color: rgb(var(--gray-dark));
		border-color: rgb(var(--gray));
	}

	.hero-image {
		width: 100%;
		height: auto;
		object-fit: cover;
		aspect-ratio: 2/1;
	}

	.content {
		padding: 1.5rem;
	}

	.title {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0.5rem 0 0.5rem;
		color: rgb(var(--black));
	}

	.dark .title {
		color: white;
	}

	.description {
		font-size: 1rem;
		color: rgb(var(--gray));
		margin: 0;
	}
</style>