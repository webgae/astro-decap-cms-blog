---
import { Image } from "astro:assets";
import CloudinaryImage from "./CloudinaryImage.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const {
  data: { title, heroImage },
  slug,
} = post;

const postSlug = slug || post.id.replace(/\.(md|mdx)$/, '');
---

<li class="recent-article-item">
  <a href={`/blog/${postSlug}/`}>
    {heroImage && (
      <div class="image-wrapper">
        {(typeof heroImage === "string" && heroImage.startsWith("http")) ? (
          <img
            src={heroImage}
            alt={title}
            width="60"
            height="60"
            loading="lazy"
            decoding="async"
            class="recent-article-image"
          />
        ) : (
          <Image
            src={heroImage}
            alt={title}
            width="60"
            height="60"
            class="recent-article-image"
          />
        )}
      </div>
    )}
    <h4 class="recent-article-title">{title}</h4>
  </a>
</li>

<style>
  .recent-article-item {
    list-style: none;
    margin-bottom: 1rem;
  }

  .recent-article-item a {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: var(--text-color);
    transition: color 0.2s ease;
  }

  .recent-article-item a:hover {
    color: var(--accent);
  }

  .image-wrapper {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--accent);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .recent-article-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .recent-article-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Dark mode adjustments */
  .dark .recent-article-item a {
    color: var(--text-color-dark);
  }

  .dark .image-wrapper {
    border-color: var(--accent-dark);
  }
</style>
