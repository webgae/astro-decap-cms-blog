---
// Componente para integrar Giscus
---
<div class="giscus-container">
   <script src="https://giscus.app/client.js"
        data-repo="ximosa/comentarios-webgae-Astro"
        data-repo-id="R_kgDOQIk3hg"
        data-category="Announcements"
        data-category-id="DIC_kwDOQIk3hs4CxEDP"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="es"
        crossorigin="anonymous"
        async>
</script>
    <script is:inline>
        // Este script soluciona el problema con Astro View Transitions.
        // Se asegura de que Giscus se recargue al navegar entre páginas.
        document.addEventListener('astro:after-swap', () => {
            // Busca el iframe de Giscus
            const giscusFrame = document.querySelector('iframe.giscus-frame');
            if (giscusFrame) {
                // Si existe, envía un mensaje para que se actualice con la nueva página
                giscusFrame.contentWindow.postMessage(
                    { giscus: { setConfig: { term: window.location.pathname } } },
                    'https://giscus.app'
                );
            }
        });
    </script>
</div>

<style>
    .giscus-container {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid rgb(var(--gray-light));
    }
</style>