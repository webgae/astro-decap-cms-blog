---
// Recibe un array de "migas" como { label: string, href?: string }
const { crumbs } = Astro.props;
---
<style>
    .breadcrumbs {
        margin-bottom: 2rem;
        font-size: 0.9em;
        color: rgb(var(--gray));
    }
    .breadcrumbs ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .breadcrumbs a {
        color: var(--accent);
        text-decoration: none;
    }
    .breadcrumbs a:hover {
        text-decoration: underline;
    }
    .breadcrumbs .separator {
        color: rgb(var(--gray));
    }
    .breadcrumbs .current-page {
        color: rgb(var(--gray-dark));
        font-weight: 600;
    }
    .dark .breadcrumbs .current-page {
        color: rgb(var(--black));
    }
</style>

<nav aria-label="Breadcrumb" class="breadcrumbs">
    <ol>
        {crumbs.map((crumb, index) => (
            <li>
                {index > 0 && <span class="separator" aria-hidden="true">/</span>}
                {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span class="current-page">{crumb.label}</span>}
            </li>
        ))}
    </ol>
</nav>