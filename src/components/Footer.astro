---
import type { CollectionEntry } from 'astro:content';

interface Props {
    pages: CollectionEntry<'pages'>[];
}

const { pages } = Astro.props;
---

<footer>
	<div class="footer-container">
		<!-- Sección de Navegación -->
		<div class="footer-section">
			<div class="section-header">
				<h3 class="footer-title">Navegación</h3>
			</div>
			<ul class="footer-links">
				<li><a href="/">Inicio</a></li>
				<li><a href="/about">Sobre mí</a></li>
				<li><a href="/contact">Contacto</a></li>
				<li><a href="/proyectos">Proyectos</a></li>
			</ul>
		</div>

		<!-- Sección Legal -->
		<div class="footer-section">
			<div class="section-header">
				<h3 class="footer-title">Legal</h3>
			</div>
			                        <ul class="footer-links">
			            				{pages && pages.map((page) => (
			            					<li><a href={`/legal/${page.slug}/`}>{page.data.title}</a></li>
			            				))}
			            			</ul>		</div>

		<!-- Sección Servicios -->
		<div class="footer-section">
			<div class="section-header">
				<h3 class="footer-title">Servicios</h3>
			</div>
			<ul class="footer-links">
				<li><a href="/contact">Consultoría Web</a></li>
				<li><a href="/contact">Desarrollo Frontend</a></li>
				<li><a href="/contact">Optimización SEO</a></li>
			</ul>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="newsletter">
			<h4>¿Quieres estar al día?</h4>
			<p>Suscríbete para recibir las últimas actualizaciones y consejos sobre desarrollo web.</p>
			<form class="newsletter-form" action="https://api.follow.it/subscription-form/UCtwV0RUTGY3SFh5WHNQa3lGcjRDT2R1eEsyQmNLMGtUekEvUWdoa0pESDJIZ2FGSUY4RUpGdU5iZkpldlErTjcxYUpSQkhDNTNFMEhWNnhKSXh2OTcvL1ZUS2dWaGRmaUNITkhBWXplalNSM1JJMTRRUUlocUI5ajE1ZE5OZy98ckdWbmtRdWJFakxmWjFRMWxWT3VZT2JDcnRHSUppenhiQmV2cW0wOWROMD0=/8" method="post">
				<input type="email" name="email" required placeholder="Tu email..." />
				<button type="submit">Suscribirme</button>
			</form>
		</div>
								<div class="copyright">
			<p>© {new Date().getFullYear()} Joaquín. Todos los derechos reservados.</p>
			<p class="admin-links">
				<a href="https://webgae.admin.datocms.com/editor" target="_blank" rel="noopener noreferrer">Admin</a>
				<span>&nbsp;|&nbsp;</span>
				<a href="/sitemap-index.xml" target="_blank" rel="noopener noreferrer">Sitemap</a>
			</p>
		</div>
	</div>
</footer>
<style>
		.admin-links {
		margin-top: 0.5rem;
		font-size: 0.8em;
		opacity: 0.7;
	}
	.admin-links a {
		color: inherit;
		text-decoration: underline;
	}
	.admin-links a:hover {
		opacity: 1;
	}
	footer {
		padding: 4rem 1.5rem 0;
		background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
		border-top: 1px solid rgb(var(--gray-light));
		animation: fadeInUp 0.6s ease-out; /* Animación de entrada más rápida */
		color: white;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.footer-container {
		max-width: 1280px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 3rem;
		margin-bottom: 3rem;
	}

	.footer-section {
		padding: 2rem;
		transition: all 0.3s ease;
		animation: slideInUp 0.5s ease-out forwards; /* Animación más rápida y suave */
		opacity: 0;
	}

	.footer-section:nth-child(1) { animation-delay: 0.1s; }
	.footer-section:nth-child(2) { animation-delay: 0.2s; }
	.footer-section:nth-child(3) { animation-delay: 0.3s; }
	.footer-section:nth-child(4) { animation-delay: 0.4s; }

	@keyframes slideInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.footer-section:hover {
		transform: translateY(-5px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
	}

	.section-header {
		display: flex;
		align-items: center;
		margin-bottom: 1.5rem;
	}

	.footer-title {
		font-size: 1.25rem;
		font-weight: bold;
		color: white;
		margin: 0;
	}

	.footer-links {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.footer-links li {
		margin-bottom: 0.75rem;
	}

	.footer-links a {
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		transition: all 0.3s ease;
		display: inline-block;
		position: relative;
	}

	.footer-links a::before {
		content: '';
		position: absolute;
		bottom: -2px;
		left: 0;
		width: 0;
		height: 2px;
		background-color: rgb(var(--accent));
		transition: width 0.3s ease;
	}

	.footer-links a:hover {
		color: rgb(var(--accent));
		transform: translateX(5px);
	}

	.footer-links a:hover::before {
		width: 100%;
	}


	.footer-bottom {
		max-width: 1280px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 2rem;
		align-items: start;
	}

	.copyright {
		text-align: right;
	}

	.copyright p {
		color: rgba(255, 255, 255, 0.8);
		font-size: 0.9em;
		margin-bottom: 0.5rem;
	}

	.dark .footer-section {
		background: linear-gradient(135deg, rgb(var(--component-bg)) 0%, rgba(var(--accent), 0.05) 100%);
	}

	.dark .social-link {
		background-color: rgb(var(--component-bg));
	}

	.dark .newsletter-input {
		background-color: rgb(var(--gray-light));
	}

	/* Estilos para el formulario de suscripción */
	.newsletter-form {
		display: flex;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.newsletter-form input {
		flex-grow: 1;
		padding: 0.75rem 1rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 8px;
		background-color: rgba(255, 255, 255, 0.1);
		color: white;
		font-size: 1rem;
		transition: background-color 0.3s, border-color 0.3s;
	}

	.newsletter-form input::placeholder {
		color: rgba(255, 255, 255, 0.6);
	}

	.newsletter-form input:focus {
		outline: none;
		background-color: rgba(255, 255, 255, 0.15);
		border-color: rgb(var(--accent));
	}

	.newsletter-form button {
		padding: 0.75rem 1.5rem;
		border: 2px solid #08d9d6; /* Borde cian para destacar */
		border-radius: 8px;
		background-color: transparent; /* Fondo transparente/negro */
		color: white;
		font-weight: bold;
		cursor: pointer;
		transition: all 0.2s ease-in-out;
		box-shadow: 0 4px 15px -5px #08d9d655; /* Sombra más sutil */
		will-change: transform;
	}

	.newsletter-form button:hover {
		background-color: #08d9d6; /* Relleno cian en hover */
		color: #1a1a1a; /* Texto oscuro en hover para contraste */
		transform: scale(1.05);
		box-shadow: 0 6px 20px -5px #08d9d699;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.footer-container {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.footer-section {
			padding: 1.5rem;
		}

		.footer-bottom {
			grid-template-columns: 1fr;
			gap: 2rem;
			text-align: center;
		}

		.copyright {
			text-align: center;
		}

		.newsletter-form {
			flex-direction: column;
		}

	}

</style>
