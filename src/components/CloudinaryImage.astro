---
// src/components/CloudinaryImage.astro
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  quality?: string;
  class?: string;
}

const { src, alt, width, height, quality = 'auto', class: className } = Astro.props;

// Extrae la parte pública de la URL de Cloudinary
const urlParts = src.split('/upload/');
const publicIdWithVersion = urlParts.length > 1 ? urlParts[1] : '';

// Construye la URL optimizada
const transformations = `f_auto,q_${quality}`;
const optimizedSrc = `https://res.cloudinary.com/djjiagkho/image/upload/${transformations}/${publicIdWithVersion}`;
---
<img 
  src={optimizedSrc} 
  alt={alt} 
  width={width} 
  height={height} 
  loading="lazy" 
  decoding="async"
  class={className}
/>
