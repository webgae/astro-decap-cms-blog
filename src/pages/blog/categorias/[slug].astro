---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../../consts';

// Función para generar slugs, por si la necesitamos.
function slugify(text) {
    return text.toString().toLowerCase().trim().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '').replace(/\-\-+/g, '-').replace(/^-+/, '').replace(/-+$/, '');
}

// 1. Generar una página estática para cada categoría existente
export async function getStaticPaths() {
    const DATO_API_URL = 'https://graphql.datocms.com/';
    const DATO_API_TOKEN = import.meta.env.DATO_API_TOKEN;

    const query = `
        query AllCategorias {
            allCategorias {
                desarrolloweb # El nombre de la categoría
            }
        }
    `;

    const response = await fetch(DATO_API_URL, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'Authorization': `Bearer ${DATO_API_TOKEN}`
        },
        body: JSON.stringify({ query })
    });

    const { data } = await response.json();
    const categories = data.allCategorias || [];

    // Devolvemos un array vacío para que no genere ninguna página de categoría por ahora
    return [].map((category) => ({
        params: { slug: category.slug },
        props: { category },
    }));
}

const { slug } = Astro.params;
const { category } = Astro.props;

// 2. Obtener los posts que pertenecen a esta categoría
const DATO_API_URL = 'https://graphql.datocms.com/';
const DATO_API_TOKEN = import.meta.env.DATO_API_TOKEN;

// Usamos el slug para filtrar los artículos.
// DatoCMS es inteligente y sabe que 'categorias' es una relación.
const postsQuery = `
    query ArticulosPorCategoria($slug: String!) {
        allArticulos(filter: { categorias: { slug: { eq: $slug } } }, orderBy: _firstPublishedAt_DESC) {
            id
            titulo
            _firstPublishedAt
        }
    }
`;

const postsResponse = await fetch(DATO_API_URL, {
    method: 'POST',
    headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'Authorization': `Bearer ${DATO_API_TOKEN}`
    },
    body: JSON.stringify({ query: postsQuery, variables: { slug } })
});

const postsResult = await postsResponse.json();
const posts = postsResult.data.allArticulos || [];

const pageTitle = `Posts en "${category.desarrolloweb}" - ${SITE_TITLE}`;
const pageDescription = `Explora todos los artículos en la categoría ${category.desarrolloweb}.`;
---

<!doctype html>
<html lang="es">
<head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <!-- Reutilizamos los estilos de la página de blog principal para mantener la consistencia -->
    <style is:global>
        @import url('/src/pages/blog/[...page].astro?raw');
    </style>
    <style>
        .category-header {
            text-align: center;
            margin-bottom: 3rem;
            padding: 1rem;
        }
        .category-header h1 {
            font-size: 2.5rem;
            color: rgb(var(--gray-dark));
            margin: 0;
        }
        .category-header p {
            font-size: 1.1rem;
            color: rgb(var(--gray));
            margin-top: 0.5rem;
        }
    </style>
</head>
<body>
    <Header />
    <main>
        <div class="blog-container">
            <div class="category-header">
                <p>Mostrando posts en la categoría:</p>
                <h1>{category.desarrolloweb}</h1>
            </div>

            <div class="posts-container">
                {posts.length > 0 ? (
                    <ul class="posts-list">
                        {posts.map((post) => (
                            <li>
                                <a href={`/blog/${slugify(post.titulo)}/`} class="article-card">
                                    <div class="article-content">
                                        <div class="post-text">
                                            <h4 class="title">{post.titulo}</h4>
                                            <p class="date">
                                                <FormattedDate date={new Date(post._firstPublishedAt)} />
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ul>
                ) : (
                    <div id="no-results">
                        <h3>No se encontraron artículos en esta categoría.</h3>
                    </div>
                )}
            </div>
        </div>
    </main>
    <Footer />
</body>
</html>