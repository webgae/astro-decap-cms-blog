---
import BlogPost from '../../../layouts/BlogPost.astro';
import { Markdown } from 'astro/components';

export async function getStaticPaths() {
    function slugify(text) {
        return text
            .toString()
            .toLowerCase()
            .trim()
            .replace(/\s+/g, '-')
            .replace(/[^\w\-]+/g, '')
            .replace(/\-\-+/g, '-')
            .replace(/^-+/, '')
            .replace(/-+$/, '');
    }

    // FIX: Define constants inside the function scope
    const DATO_API_URL = 'https://graphql.datocms.com/';
    const DATO_API_TOKEN = import.meta.env.DATO_API_TOKEN;

    // Por ahora, crear categorías manualmente hasta que estén disponibles en DatoCMS
    const categories = [
        { id: '1', nombre: 'Desarrollo Web' },
        { id: '2', nombre: 'CMS' },
        { id: '3', nombre: 'Accesibilidad' }
    ];

    return categories.map((categoria) => ({
        params: { categoria: slugify(categoria.nombre) },
        props: { categoria }
    }));
}

const { categoria } = Astro.params;
const { categoria: categoriaData } = Astro.props;

function slugify(text) {
    return text
        .toString()
        .toLowerCase()
        .trim()
        .replace(/\s+/g, '-')
        .replace(/[^\w\-]+/g, '')
        .replace(/\-\-+/g, '-')
        .replace(/^-+/, '')
        .replace(/-+$/, '');
}

// FIX: Define constants again for the component render scope
const DATO_API_URL = 'https://graphql.datocms.com/';
const DATO_API_TOKEN = import.meta.env.DATO_API_TOKEN;

// Por ahora, obtener todos los posts y filtrar manualmente por categoría
// Una vez que tengas las categorías en DatoCMS, puedes cambiar esto
const allPostsQuery = `
    query AllPosts {
        allArticulos {
            id
            titulo
            contenidoPost
            fecha
            imagen {
                url
                alt
                title
            }
        }
    }
`;

const postsResponse = await fetch(DATO_API_URL, {
    method: 'POST',
    headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'Authorization': `Bearer ${DATO_API_TOKEN}`
    },
    body: JSON.stringify({ query: allPostsQuery })
});

const postsData = await postsResponse.json();
const allPosts = postsData.data?.allArticulos || [];

// Filtrar posts por categoría (temporal - cambiar cuando tengas categorías en DatoCMS)
// Por ahora mostrar todos los posts en cada categoría
const posts = allPosts;

console.log(`Posts for category ${categoriaData.nombre}:`, posts);
---

<BlogPost
    slug={`categorias/${categoria}`}
    title={`Categoría: ${categoriaData.nombre}`}
    description={`Artículos de la categoría ${categoriaData.nombre}`}
    pubDate={new Date()}
    heroImage=""
    relatedPosts={[]}
>
    <h2>Artículos en la categoría: {categoriaData.nombre}</h2>

    {posts.length === 0 ? (
        <p>No hay artículos en esta categoría aún.</p>
    ) : (
        <div class="posts-list">
            {posts.map((post) => (
                <article class="post-preview">
                    {post.imagen && (
                        <img
                            src={post.imagen.url}
                            alt={post.imagen.alt || post.titulo}
                            class="post-image"
                        />
                    )}
                    <h3>
                        <a href={`/blog/${slugify(post.titulo)}`}>{post.titulo}</a>
                    </h3>
                    <p class="post-date">
                        Publicado el {new Date(post.fecha).toLocaleDateString('es-ES')}
                    </p>
                    <div class="post-excerpt" set:html={post.contenidoPost.substring(0, 200) + '...'} />
                    <a href={`/blog/${slugify(post.titulo)}`} class="read-more">Leer más</a>
                </article>
            ))}
        </div>
    )}

    <p><a href="/blog">← Volver al blog</a></p>
</BlogPost>

<style>
    .posts-list {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .post-preview {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 1.5rem;
        background: #fff;
    }

    .post-image {
        width: 100%;
        max-width: 300px;
        height: auto;
        border-radius: 4px;
        margin-bottom: 1rem;
    }

    .post-preview h3 {
        margin: 0 0 0.5rem 0;
    }

    .post-preview h3 a {
        color: #333;
        text-decoration: none;
    }

    .post-preview h3 a:hover {
        color: #007acc;
    }

    .post-date {
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    .post-excerpt {
        margin-bottom: 1rem;
        line-height: 1.6;
    }

    .read-more {
        display: inline-block;
        color: #007acc;
        text-decoration: none;
        font-weight: bold;
    }

    .read-more:hover {
        text-decoration: underline;
    }
</style>