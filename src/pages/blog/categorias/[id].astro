---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SITE_TITLE } from '../../../consts';
import ArticleCard from '../../../components/ArticleCard.astro';
import { fetchDatoCMS } from '../../../lib/datocms.js';
import { getCollection } from 'astro:content';
import { slugify } from '../../../utils.js';

// 1. Generar una página estática para cada categoría existente
export async function getStaticPaths() {
    const query = `
        query AllCategorias {
            allArticulos {
                categorias {
                    id
                    desarrolloweb
                }
            }
        }
    `;

    const data = await fetchDatoCMS({ query });

    // Extraemos todas las categorías de todos los artículos y eliminamos duplicados
    const allCategoriesWithDuplicates = data.allArticulos.flatMap(articulo => articulo.categorias);
    const uniqueCategories = allCategoriesWithDuplicates.reduce((acc, current) => {
        if (!acc.find(item => item.id === current.id)) {
            acc.push(current);
        }
        return acc;
    }, []);

    if (!uniqueCategories) {
        return [];
    }

    return uniqueCategories.map((category) => ({
        params: { id: category.id },
        props: { category },
    }));
}

const { id } = Astro.params;
const { category } = Astro.props;

// 2. Obtener los posts que pertenecen a esta categoría
// Usamos el ID de la categoría para filtrar los artículos.
// La consulta `any: true` busca si el ID de la categoría está en la lista de categorías del artículo.
const postsQuery = `
    query ArticulosPorCategoria($id: ItemId!) {
        allArticulos(
            filter: { categorias: { anyIn: [$id] } }
            orderBy: _firstPublishedAt_DESC
        ) {
            id
            titulo
            _firstPublishedAt
            imagen {
                url
                alt
            }
            categorias {
                id
                desarrolloweb
            }
        }
    }
`;

let posts = [];
try {
    const data = await fetchDatoCMS({ query: postsQuery, variables: { id } });
    posts = data?.allArticulos || [];
} catch (error) {
    console.error(`Error al obtener posts para la categoría ${id}:`, error.message);
    // No lanzamos un error para que la página aún pueda mostrar el encabezado
}

if (!category) {
    // Previene un error si la página se intenta renderizar sin las props correctas
    return new Response(null, { status: 404, statusText: 'Not Found' });
}

const pageTitle = `Posts en "${category.desarrolloweb}" - ${SITE_TITLE}`;
const pageDescription = `Explora todos los artículos en la categoría ${category.desarrolloweb}.`;

// Obtenemos las páginas legales para el footer
const legalPages = await getCollection('pages');
---

<!doctype html>
<html lang="es">
<head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <!-- Reutilizamos los estilos de la página de blog principal para mantener la consistencia -->
    <style is:global>
        @import url('/src/pages/blog/[...page].astro?raw');
    </style>
    <style>
        .category-header {
            text-align: center;
            margin-bottom: 3rem;
            padding: 1rem;
        }
        .category-header h1 {
            font-size: 2.5rem;
            color: rgb(var(--gray-dark));
            margin: 0;
        }
        .category-header p {
            font-size: 1.1rem;
            color: rgb(var(--gray));
            margin-top: 0.5rem;
        }
        .blog-container {
            /* Añadimos margen inferior para separar del footer */
            margin-bottom: 4rem;
        }

        /* Estilos copiados de la página principal del blog para consistencia */
        .posts-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
            list-style-type: none;
            margin: 0;
            padding: 0;
        }

        #no-results {
            text-align: center;
            padding: 2rem;
        }
        @media (max-width: 768px) {
            .posts-list {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <Header />
    <main>
        <div class="blog-container">
            <div class="category-header">
                <p>Mostrando posts en la categoría:</p>
                <h1>{category.desarrolloweb}</h1>
            </div>

            <div class="posts-container">
                {posts.length > 0 ? (
                    <ul class="posts-list">
                        {posts.map((post) => (
                            <li><ArticleCard {post} /></li>
                        ))}
                    </ul>
                ) : (
                    <div id="no-results">
                        <h3>No se encontraron artículos en esta categoría.</h3>
                    </div>
                )}
            </div>
        </div>
    </main>
    <Footer pages={legalPages} />
</body>
</html>