---
import BaseHead from '../../components/BaseHead.astro';
import { Image } from 'astro:assets';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import ArticleCard from '../../components/ArticleCard.astro'; // Importamos el nuevo componente
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils.js';

export const prerender = true;

const PAGE_SIZE = 10;

export async function getStaticPaths({ paginate }) {
    // FIX: Usar variables de DatoCMS
    const DATO_API_URL = 'https://graphql.datocms.com/';
    const DATO_API_TOKEN = import.meta.env.DATO_API_TOKEN;

    const metaQuery = `
        query AllArticulosMeta {
            _allArticulosMeta {
                count
            }
            allArticulos {
                id
            }
        }
    `;

    const metaResponse = await fetch(DATO_API_URL, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'Authorization': `Bearer ${DATO_API_TOKEN}`
        },
        body: JSON.stringify({ query: metaQuery })
    });

    const metaResult = await metaResponse.json();
    console.log('Meta response:', metaResult);

    if (!metaResult.data || !metaResult.data._allArticulosMeta) {
        console.error('Meta query failed:', metaResult);
        console.log('Available data:', metaResult.data);
        throw new Error('No se pudo obtener el conteo de artículos. Verifica el nombre del modelo en DatoCMS.');
    }

    const totalPosts = metaResult.data._allArticulosMeta.count;
    console.log('Total posts found:', totalPosts);
    const pageCount = Math.ceil(totalPosts / 10);

    const pagePaths = Array.from({ length: pageCount || 1 }, (_, i) => ({
        params: { page: (i + 1).toString() },
        props: {},
    }));

    return paginate(pagePaths, { pageSize: 1 });
}

const { page } = Astro.props;
const currentPage = parseInt(Astro.params.page || '1', 10);

// FIX: Usar variables de DatoCMS
const DATO_API_URL = 'https://graphql.datocms.com/';
const DATO_API_TOKEN = import.meta.env.DATO_API_TOKEN;

const postsQuery = `
    query AllArticulos {
        allArticulos(first: 10, skip: ${(currentPage - 1) * 10}, orderBy: _firstPublishedAt_DESC) {
            id
            titulo
            _firstPublishedAt
            categorias {
                desarrolloweb
                id
            }
            imagen {
                url
                alt
            }
            categorias {
                desarrolloweb
                id
            }
        }
    }
`;

const postsResponse = await fetch(DATO_API_URL, {
    method: 'POST',
    headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'Authorization': `Bearer ${DATO_API_TOKEN}`
    },
    body: JSON.stringify({ query: postsQuery })
});

const postsResult = await postsResponse.json();
console.log('Posts response:', postsResult);

if (postsResult.errors) {
    console.error('GraphQL errors:', postsResult.errors);
    throw new Error('Errores en la query GraphQL. Verifica los campos del modelo.');
}

if (!postsResult.data) {
    console.error('Posts query failed - no data:', postsResult);
    throw new Error('No se pudieron obtener los artículos. Verifica la configuración en DatoCMS.');
}

const posts = postsResult.data.allArticulos || [];
console.log('Posts array:', posts);

const pageTitle = `Blog - ${SITE_TITLE}`;
const pageDescription = "Explora nuestros últimos artículos, tutoriales y noticias sobre desarrollo web y tecnología.";

// Obtenemos las páginas legales para el footer
const legalPages = await getCollection('pages');
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			.blog-container {
				width: 100%;
				max-width: 1200px;
				margin: 2rem auto;
				padding: 0 1.5rem;
				box-sizing: border-box;
			}

			.search-container {
				position: relative;
				margin-bottom: 2.5rem;
			}

			#search-input {
				width: 100%;
				padding: 1rem 1rem 1rem 3.5rem; /* Espacio para el icono */
				font-size: 1.1rem;
				border-radius: 12px;
				border: 1px solid rgb(var(--gray-light));
				background-color: rgb(var(--card-bg));
				color: rgb(var(--text));
				transition: border-color 0.3s, box-shadow 0.3s;
			}

			#search-input:focus {
				outline: none;
				border-color: rgb(var(--accent));
				box-shadow: 0 0 0 3px rgba(var(--accent), 0.3);
			}

			.search-icon {
				position: absolute;
				top: 50%;
				left: 1.25rem;
				transform: translateY(-50%);
				color: rgb(var(--gray));
				pointer-events: none; /* Para que no interfiera con el clic en el input */
			}

						.posts-list {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			/* Eliminamos los estilos de la tarjeta individual porque ahora están en el componente */

			#no-results {
				width: 100%;
				text-align: center;
				padding: 3rem;
				color: rgb(var(--gray));
				background-color: #fff;
				border-radius: 12px;
			}
			.pagination {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 1rem;
				margin-top: 3rem;
				flex-wrap: wrap;
			}
			.page-numbers {
				display: flex;
				gap: 0.5rem;
				align-items: center;
			}
			.page-number, .pagination a {
				padding: 0.75rem 1rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				text-decoration: none;
				background-color: rgb(var(--component-bg));
				color: rgb(var(--gray-dark));
				font-weight: 600;
				transition: background-color 0.2s, color 0.2s;
				min-width: 2.5rem;
				text-align: center;
			}
			.dark .page-number, .dark .pagination a {
				background-color: rgb(var(--component-bg));
				color: rgb(var(--black));
			}
			.page-number:hover, .pagination a:hover {
				background-color: rgb(var(--accent));
				color: white;
				border-color: rgb(var(--accent));
			}
			.page-number.current {
				background-color: rgb(var(--accent));
				color: rgb(10, 4, 4);
				border-color: rgb(var(--accent));
				font-weight: 700;
			}
			@media (max-width: 768px) {
				.posts-list {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="blog-container">
				<div class="search-container">
					<input type="search" id="search-input" placeholder="Buscar artículos por título..." aria-label="Buscar artículos" />
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
				</div>

                                <div class="posts-container">
                    <ul class="posts-list">
                        {posts && posts.map((post) => (
                            <li data-title={post.titulo.toLowerCase()}>
                                <ArticleCard {post} />
                            </li>
                        ))}
                    </ul>

                    {posts && posts.length === 0 && (
                        <div id="no-results">
                            <h3 id="no-results-title">No hay artículos todavía</h3>
                            <p>Crea tu primer post en DatoCMS para verlo aquí.</p>
                        </div>
                    )}

                    <div class="pagination">
                        {page.url.prev && <a href={page.url.prev}>&laquo; Anteriores</a>}
                        <div class="page-numbers">
                            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(pageNum => {
                                const isCurrentPage = pageNum === page.currentPage;
                                const pageUrl = pageNum === 1 ? '/blog/' : `/blog/${pageNum}/`;
                                return isCurrentPage ? (
                                    <span class="page-number current">{pageNum}</span>
                                ) : (
                                    <a href={pageUrl} class="page-number">{pageNum}</a>
                                );
                            })}
                        </div>
                        {page.url.next && <a href={page.url.next}>Siguientes &raquo;</a>}
                    </div>
                </div>
			</div>
		</main>
		<Footer pages={legalPages} />
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const searchInput = document.getElementById('search-input') as HTMLInputElement;
				const postList = document.querySelector('.posts-list') as HTMLUListElement;
				const postItems = Array.from(postList.querySelectorAll('li'));
				const noResultsDiv = document.getElementById('no-results') as HTMLDivElement;
				const noResultsTitle = document.getElementById('no-results-title') as HTMLHeadingElement;
				const pagination = document.querySelector('.pagination') as HTMLElement;

				searchInput.addEventListener('input', () => {
					const searchTerm = searchInput.value.toLowerCase().trim();
					let visibleCount = 0;

					postItems.forEach(item => {
						const title = item.dataset.title || '';
						const isVisible = title.includes(searchTerm);
						item.style.display = isVisible ? '' : 'none';
						if (isVisible) {
							visibleCount++;
						}
					});

					// Mostrar u ocultar el mensaje de "no hay resultados"
					const showNoResults = visibleCount === 0 && postItems.length > 0;
					noResultsDiv.style.display = showNoResults ? 'block' : 'none';
					noResultsTitle.textContent = 'No se encontraron resultados';

					// Ocultar paginación durante la búsqueda
					pagination.style.display = searchTerm ? 'none' : 'flex';
				});
			});
		</script>
	</body>
</html>