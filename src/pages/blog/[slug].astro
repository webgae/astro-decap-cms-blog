---
import BlogPost from '../../layouts/BlogPost.astro';
import { fetchDatoCMS, getOptimizedImageUrl } from '../../lib/datocms.js';
import { slugify } from '../../utils.js';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
    const query = `
        query AllArticulos {
            allArticulos {
                id
                titulo
            }
        }
    `;

    const data = await fetchDatoCMS({ query });
    const posts = data.allArticulos;

    if (!posts) return [];

    return posts.map((post) => ({
        params: { slug: slugify(post.titulo) },
        props: { posts }
    }));
}

const { slug } = Astro.params;
const { posts } = Astro.props;

// Convertir slug de URL a ID para buscar en DatoCMS
const postId = posts.find(p => slugify(p.titulo) === slug)?.id;
if (!postId) {
    console.error('Post not found for slug:', slug);
    return Astro.redirect('/404');
}

const query = `
    query ArticuloById($id: ItemId!) {
        articulo(filter: { id: { eq: $id } }) {
            id
            titulo
            contenidoPost
            fecha
            imagen {
                url
                alt
                title
            }
            categorias {
                desarrolloweb
            }
        }
    }
`;

const data = await fetchDatoCMS({ query, variables: { id: postId } });
const post = data?.articulo;

if (!post) {
    console.error('Post not found for ID:', slug.replace('post-', ''));
    return Astro.redirect('/404');
}

const { titulo, contenidoPost, fecha, imagen, categorias } = post;
const pubDate = fecha;

const optimizedHeroImage = imagen ? getOptimizedImageUrl({
    src: imagen.url,
    width: 1200,
    format: 'webp',
    fit: 'max' // 'max' para ajustar sin cortar
}) : null;
---

<BlogPost
    slug={slug}
    title={titulo}
    description="Artículo de blog"
    pubDate={new Date(pubDate)}
        categories={categorias}
>
    {optimizedHeroImage && (
        <Image 
            src={optimizedHeroImage} 
            alt={imagen.alt || titulo} 
            width={1200} 
            height={600}  
            class="hero-image" 
        />
    )}
    <div set:html={contenidoPost} />
</BlogPost>

<style is:global>
    .categoria {
        margin: 1rem 0;
        font-style: italic;
    }

    /* Estilos para bloques de código (pre) */
    pre {
        background-color: #1a1a1a; /* Fondo oscuro para el bloque de código */
        color: #e0e0e0; /* Color de texto claro */
        padding: 1.2em 1.5em;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        overflow-x: auto; /* Permite desplazamiento horizontal si el código es muy largo */
        font-family: 'Fira Code', 'Cascadia Code', 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;
        font-size: 0.95em;
        line-height: 1.6;
        border: 1px solid rgba(8, 217, 214, 0.3); /* Borde sutil con el color de acento */
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3); /* Sombra para darle profundidad */
    }

    /* Estilos para el código en línea (code) */
    code {
        background-color: rgba(8, 217, 214, 0.1); /* Fondo sutil con el color de acento */
        color: #08d9d6; /* Color de texto del acento */
        padding: 0.2em 0.4em;
        border-radius: 4px;
        font-family: 'Fira Code', 'Cascadia Code', 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;
        font-size: 0.9em;
        white-space: nowrap; /* Evita que el código en línea se rompa */
    }

    /* Asegurarse de que el código dentro de pre no tenga el fondo del código en línea */
    pre code {
        background-color: transparent;
        color: inherit;
        padding: 0;
        border-radius: 0;
        font-size: inherit;
        white-space: pre; /* Mantiene el formato original del código */
    }
</style>