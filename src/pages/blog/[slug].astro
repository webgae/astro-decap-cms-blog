---
import BlogPost from '../../layouts/BlogPost.astro';
import { Markdown } from 'astro/components';

export async function getStaticPaths() {
    function slugify(text) {
        return text
            .toString()
            .toLowerCase()
            .trim()
            .replace(/\s+/g, '-')
            .replace(/[^\w\-]+/g, '')
            .replace(/\-\-+/g, '-')
            .replace(/^-+/, '')
            .replace(/-+$/, '');
    }

    // FIX: Define constants inside the function scope
    const DATO_API_URL = 'https://graphql.datocms.com/';
    const DATO_API_TOKEN = import.meta.env.DATO_API_TOKEN;

    const query = `
        query AllArticulos {
            allArticulos {
                id
                titulo
            }
        }
    `;

    const response = await fetch(DATO_API_URL, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'Authorization': `Bearer ${DATO_API_TOKEN}`
        },
        body: JSON.stringify({ query })
    });

    const { data } = await response.json();
    const posts = data.allArticulos;

    if (!posts) return [];

    return posts.map((post) => ({
        params: { slug: slugify(post.titulo) },
        props: { posts }
    }));
}

const { slug } = Astro.params;
const { posts } = Astro.props;

function slugify(text) {
    return text
        .toString()
        .toLowerCase()
        .trim()
        .replace(/\s+/g, '-')
        .replace(/[^\w\-]+/g, '')
        .replace(/\-\-+/g, '-')
        .replace(/^-+/, '')
        .replace(/-+$/, '');
}

// FIX: Define constants again for the component render scope
const DATO_API_URL = 'https://graphql.datocms.com/';
const DATO_API_TOKEN = import.meta.env.DATO_API_TOKEN;

// Convertir slug de URL a ID para buscar en DatoCMS
const postId = posts.find(p => slugify(p.titulo) === slug)?.id;
if (!postId) {
    console.error('Post not found for slug:', slug);
    return Astro.redirect('/404');
}

const query = `
    query ArticuloById($id: ItemId!) {
        articulo(filter: { id: { eq: $id } }) {
            id
            titulo
            contenidoPost
            fecha
            imagen {
                url
                alt
                title
            }
            categorias {
                desarrolloweb
            }
        }
    }
`;

const response = await fetch(DATO_API_URL, {
    method: 'POST',
    headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'Authorization': `Bearer ${DATO_API_TOKEN}`
    },
    body: JSON.stringify({ query, variables: { id: postId } })
});

const { data, errors } = await response.json();
console.log('Single post response:', data);
console.log('Errors:', errors);
console.log('Content:', data?.articulo?.contenidoPost);
console.log('Full post data:', JSON.stringify(data?.articulo, null, 2));
const post = data?.articulo;

if (!post) {
    console.error('Post not found for ID:', slug.replace('post-', ''));
    return Astro.redirect('/404');
}

const { titulo, contenidoPost, fecha, imagen, categorias } = post;
const pubDate = fecha;
const heroImage = imagen?.url || "";
---

<BlogPost
    slug={slug}
    title={titulo}
    description="Artículo de blog"
    pubDate={new Date(pubDate)}
    relatedPosts={[]}
    categories={categorias}
>
    {imagen && <img src={imagen.url} alt={imagen.alt || titulo} title={imagen.title || titulo} class="hero-image" />}
    <div set:html={contenidoPost} />
</BlogPost>

<style>
    .categoria {
        margin: 1rem 0;
        font-style: italic;
    }
</style>